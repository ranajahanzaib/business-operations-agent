# Copy to .env. Defaults work for a local Ollama installation.
OPSAGENT_DB=data/opsagent.sqlite3
OPSAGENT_PROVIDER=ollama
OPSAGENT_MODEL=qwen3:4b-instruct
OPSAGENT_TEMPERATURE=0.1
OPSAGENT_NUM_CTX=8192
OPSAGENT_MAX_TOKENS=2048
OPSAGENT_MODEL_TIMEOUT_SECONDS=60
OPSAGENT_EXECUTION_TIMEOUT_SECONDS=300
OPSAGENT_MAX_ITERATIONS=12
OPSAGENT_MAX_TOOL_CALLS=25
OPSAGENT_MAX_PROPOSED_ACTIONS=30
OPSAGENT_MAX_IDENTICAL_TOOL_CALLS=3
OPSAGENT_MAX_RESPONSE_RETRIES=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# Optional for local OpenAI-compatible servers that require authentication.
# OPENAI_COMPATIBLE_API_KEY=
OPSAGENT_AS_OF=2026-11-10T12:00:00+00:00
# Public demo credentials. Keep the service local; it is not hardened for network exposure.
OPSAGENT_OPERATOR_TOKEN=local-operator-token
OPSAGENT_AUDITOR_TOKEN=local-auditor-token
